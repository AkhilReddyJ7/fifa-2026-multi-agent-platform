# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fifa2026
POSTGRES_USER=fifa_user
POSTGRES_PASSWORD=fifa_pass
DATABASE_URL=postgresql+asyncpg://fifa_user:fifa_pass@localhost:5432/fifa2026

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB ─────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_MATCH_REPORTS=match_reports
CHROMA_COLLECTION_TEAM_PROFILES=team_profiles
CHROMA_COLLECTION_WC_HISTORY=world_cup_history

# ── LLM (OpenAI-compatible) ──────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ── Rate limits ──────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
